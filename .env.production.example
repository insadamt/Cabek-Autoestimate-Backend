# Production-only runtime configuration.
# Copy this file to .env.production. Keep .env for local development.
# .env.production is ignored by Git and must never be committed with real secrets.

APP_NAME=AutoEstimate
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_DATABASE=autoestimate
DB_USERNAME=autoestimate
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database

AUTOESTIMATE_API_RATE_LIMIT=120

# Host-side Docker settings. Keep 127.0.0.1 when a reverse proxy runs on
# the same server. Use 0.0.0.0 only when AutoEstimate must be directly
# reachable from the server network.
AUTOESTIMATE_BIND_ADDRESS=127.0.0.1
AUTOESTIMATE_HTTP_PORT=8080
AUTOESTIMATE_IMAGE_TAG=latest
